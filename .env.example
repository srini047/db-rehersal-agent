# Redis database 4 is where SONiC keeps CONFIG_DB.
REDIS_URL=redis://localhost:6379/4

# Where the MCP server listens, and the URL TrueForge uses to reach it.
# TrueForge blocks private addresses by default; start it with
# OUTBOUND_URL_ALLOWED_HOSTS='["127.0.0.1"]' so it may reach this one.
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_URL=http://127.0.0.1:8765/mcp

# Docker Sandbox (sbx) that runs the agent's rehearsal scripts.
SANDBOX_NAME=sonic-rehearsal
REHEARSAL_TIMEOUT_SECONDS=60

# Local TrueForge (started with `npx @truefoundry/trueforge`).
TRUEFORGE_BASE_URL=http://localhost:8790

# A model FQN from TrueForge Settings -> Models, e.g. openai/gpt-5.2
TRUEFORGE_MODEL=
